# rm -rf ~/.local/bin/claude ~/.local/share/claude

# # Apple — from App Store Connect → In-App Purchases → Shared Secret
# APPLE_IAP_SHARED_SECRET=your_secret_here

# # Google — service account JSON from Google Play Console → Setup → API access
# # Paste the entire JSON as one line (or use a file path handler)
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":...}

# # Your Android app package name
# GOOGLE_PLAY_PACKAGE_NAME=com.novelux.app


